{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "postinstall": "npx prisma generate",
    "start": "tsx server.ts",
    "start:prod": "node dist/server.js",
    "server": "nodemon --exec tsx server.ts",
    "build": "tsc",
    "postbuild": "node -e \"import('node:fs').then(fs => { fs.mkdirSync('dist/configs', { recursive: true }); fs.copyFileSync('configs/instrument.mjs', 'dist/configs/instrument.mjs'); })\"",
    "promote-admin": "tsx scripts/promote-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "reconcile:payments": "tsx scripts/reconcile-payments.ts",
    "check:payments": "tsx scripts/check-payment-env.ts",
    "checkout:test": "tsx scripts/test-checkout.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@clerk/express": "^1.7.61",
    "@google/genai": "^2.32.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@sentry/node": "^10.32.1",
    "@types/uuid": "^10.0.0",
    "axios": "^1.13.2",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "razorpay": "^2.9.6",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.11",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
